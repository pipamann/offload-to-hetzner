def shell_value(rest):
    """Value after NAME= as a shell would set it, without running anything (export X="a\\"b" # c gives a"b).
    None for a reference such as $Y, whose value is unknown here. ValueError for syntax that cannot be read safely."""
    s, i, parts = rest.strip(), 0, []

    def reference(pos):
        return s[pos] == "`" or (s[pos] == "$" and pos + 1 < len(s) and bool(SHELL_EXPANSION_RE.match(s[pos + 1])))

    if rest[:1].isspace() and s.startswith("#"):
        return ""
    while i < len(s) and not s[i].isspace():
        c = s[i]
        if c == "'":
            end = s.find("'", i + 1)
            if end < 0:
                raise ValueError("open single quote")
            parts.append(s[i + 1:end])
            i = end + 1
        elif c == '"':
            i += 1
            while i < len(s) and s[i] != '"':
                if s[i] == "\\" and i + 1 < len(s):
                    parts.append(s[i + 1] if s[i + 1] in '$`"\\' else s[i:i + 2])
                    i += 2
                    continue
                if reference(i):
                    return None
                parts.append(s[i])
                i += 1
            if i >= len(s):
                raise ValueError("open double quote")
            i += 1
        elif c == "\\":
            if i + 1 >= len(s):
                raise ValueError("backslash at end of line")
            parts.append(s[i + 1])
            i += 2
        elif reference(i):
            return None
        elif c in ";&|<>()" or (c == "$" and s[i + 1:i + 2] in ("'", '"')):
            raise ValueError("shell operator outside quotes")
        else:
            parts.append(c)
            i += 1
    return "".join(parts)


ENV_SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "vendor", "dist", "build", "target", "__pycache__"}


def project_env_files(base):
    """The .env* files of the project around `base`: in base, in the current folder, and up to three folder levels
    below the git work tree root (monorepos keep them in apps/<name>/.env). Templates (.example ...) are skipped."""
    roots = [base.resolve(), Path.cwd()]
    r = subprocess.run(["git", "-C", str(base), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    top = Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None
    found = set()
    for root in roots:
        found |= {p for p in root.glob(".env*")}
    if top:
        for here, dirs, names in os.walk(top):
            depth = len(Path(here).relative_to(top).parts)
            dirs[:] = [] if depth >= 3 else [x for x in dirs if x not in ENV_SKIP_DIRS]
            found |= {Path(here) / n for n in names if n.startswith(".env")}
    return sorted(p for p in found if p.is_file() and not re.search(r"\.(example|sample|template|dist)$", p.name))


def raw_value(rest):
    """The text after NAME= taken literally (dotenv parsers keep `$` as is): quotes and a trailing comment removed."""
    s = re.sub(r"\s+#.*$", "", rest.strip())
    return s[1:-1] if len(s) >= 2 and s[0] == s[-1] and s[0] in "'\"" else s


def secret_values(base):
    """Known secret values (bytes -> variable name): environment variables with secret-like names, every
    assignment in the files of $OFFLOAD_SECRET_FILES, and the project's own .env files."""
    found = {}

    def add(value, name):
        # Values under a credential-like name count from 8 characters, numbers included; any other value in a
        # secrets file from 12 characters, without origins, local paths and numbers (fewer false alarms).
        named = bool(SECRET_NAME_RE.search(name))
        harmless = HARMLESS_RE.match(value or "") and not (named and value.isdigit())
        if value and len(value) >= (8 if named else 12) and not harmless:
            found.setdefault(value.encode(errors="surrogateescape"), name)

    for name, value in os.environ.items():
        if SECRET_NAME_RE.search(name):
            add(value, name)
    for path, strict in [(p, True) for p in SECRET_FILES] + [(p, False) for p in project_env_files(base)]:
        if not path.exists():
            say(f"secret scan: {path} not found, scanning without it")
            continue
        for number, line in enumerate(path.read_text(errors="ignore").splitlines(), 1):
            m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)", line)
            if not m:
                continue
            try:
                value = shell_value(m.group(2))
                # In a project .env file, $ is a literal for dotenv loaders (a shell would expand it): count it as written.
                add(raw_value(m.group(2)) if value is None and not strict else value, m.group(1))
            except ValueError as err:
                if strict:  # only line number and reason, never the value
                    die(f"{path}, line {number} not readable ({err}). Write it more simply; the file is never executed.")
                add(raw_value(m.group(2)), m.group(1))  # a dotenv loader takes it literally (a URL with & in it ...)
    return found


def secret_matchers(base):
    values = secret_values(base)
    rx = re.compile(b"|".join(re.escape(v) for v in sorted(values, key=len, reverse=True))) if values else None
    return values, rx


def find_secret(data, values, rx):
    if rx and (m := rx.search(data)):
        return f"contains the value of ${values[m.group(0)]}"
    if m := TOKEN_RE.search(data):
        return f"looks like a {m.lastgroup.replace('_', ' ')}"
    return None


class ScanReader:
    """Hands a file to the archive and scans exactly the bytes that go into it."""

    def __init__(self, f, values, rx, overlap):
        self.f, self.values, self.rx, self.overlap, self.tail, self.why = f, values, rx, overlap, b"", None

    def read(self, n=-1):
        data = self.f.read(n)
        if data and not self.why:
            buf = self.tail + data
            self.why = find_secret(buf, self.values, self.rx)
            self.tail = buf[-self.overlap:]
        return data


def redact(text, values, rx):
    """A path as it may be printed: known secret values and token formats in it replaced by [REDACTED]."""
    data = text.encode(errors="surrogateescape")
    if rx:
        data = rx.sub(b"[REDACTED]", data)
    return TOKEN_RE.sub(b"[REDACTED]", data).decode(errors="surrogateescape")


def name_hit(rel, values, rx):
    if SECRET_FILE_RE.search(rel):
        return "file name suggests credentials"
    if DATA_FILE_RE.search(rel):
        return "database dump or data file (customer data stays on the Mac)"
    if why := find_secret(rel.encode(errors="surrogateescape"), values, rx):
        return f"the name {why}"
    return None


def report(hits, files, size, values, allowed):
    note = f", {allowed} skipped by --allow" if allowed else ""
    say(f"secret scan: {files} files, {size / 1e6:.1f} MB, {len(values)} known values + token formats, {len(hits)} hits{note}")
    if hits:
        for h in hits[:40]:
            print(f"  BLOCKED {h}", file=sys.stderr)
        die("nothing uploaded. Remove these files or values, or pass --allow <path or glob> after checking each one is harmless.")


def pack(base, files, allow, dirs=()):
    """Builds the upload as a .tar.gz on this Mac from exactly the bytes the scan saw, so a file changed afterwards
    cannot slip through, and blocks it when a name suggests credentials or data dumps, or a name, a link target or
    content holds a known secret value or a common token format. Blind to secrets that are neither known here nor in a
    known format: customer data needs judgment. Returns the archive's path; the caller deletes it."""
    values, rx = secret_matchers(base)
    overlap = max([len(v) for v in values] + [200])
    hits, allowed, size = [], 0, 0
    fd, out = tempfile.mkstemp(prefix="upload-", suffix=".tgz", dir=STATE)
    os.close(fd)
    try:
        with tarfile.open(out, "w:gz", compresslevel=6) as tf:
            for rel in dirs:
                if not any(fnmatch.fnmatch(rel, g) for g in allow) and (why := name_hit(rel, values, rx)):
                    hits.append(f"{redact(rel, values, rx)}/: {why}")
                    continue
                tf.add(base / rel, arcname=rel, recursive=False)
            for rel in files:
                check = not any(fnmatch.fnmatch(rel, g) for g in allow)
                allowed += not check
                if check and (why := name_hit(rel, values, rx)):
                    hits.append(f"{redact(rel, values, rx)}: {why}")
                    continue
                tf.inodes.clear()  # each path as itself: a second name of the same file must not become a hard-link entry
                info = tf.gettarinfo(str(base / rel), arcname=rel)  # a link stays a link; its target stays home
                if info.issym():
                    if check and (why := find_secret(info.linkname.encode(errors="surrogateescape"), values, rx)):
                        hits.append(f"{redact(rel, values, rx)}: the link target {why}")
                        continue
                    tf.addfile(info)
                elif info.isreg():
                    size += info.size
                    with open(base / rel, "rb") as f:
                        reader = ScanReader(f, values, rx, overlap) if check else f
                        try:
                            tf.addfile(info, reader)
                        except OSError:
                            die(f"{redact(rel, values, rx)} changed while it was packed; nothing uploaded, try again")
                    if check and reader.why:
                        hits.append(f"{redact(rel, values, rx)}: {reader.why}")
    except BaseException:
        os.unlink(out)
        raise
    if hits:
        os.unlink(out)
    report(hits, len(files), size, values, allowed)
    return out


def scan_blob(base, rel, data):
    """The same checks for one piece of data that goes out as it is (a setup script)."""
    values, rx = secret_matchers(base)
    why = name_hit(rel, values, rx) or find_secret(data, values, rx)
    report([f"{redact(rel, values, rx)}: {why}"] if why else [], 1, len(data), values, 0)

def check_outgoing(*texts):
    """Every string that goes to the server outside a scanned file: commands, --cwd, remote paths."""
    values, rx = secret_matchers(Path.cwd())
    for text in texts:
        if text and (why := find_secret(text.encode(errors="surrogateescape"), values, rx)):
            die(f"an argument for the server {why}. Nothing sent. Keep secrets on the Mac (check for a $VAR your shell expanded).")


# ---------------------------------------------------------------- server lifecycle

def start_watchdog(task, info):
    """A detached process on this Mac that deletes server and key of this run at the expiry. caffeinate -i keeps the
    Mac from idle sleep meanwhile (closing the lid on battery still sleeps it). The token reaches it through the
    environment only."""
    log = state_dir(task) / "watchdog.log"
    cmd = [sys.executable, str(Path(__file__).resolve()), "_watchdog", WATCHDOG_MARK, info["run"], str(info["expires"]), str(log)]
    if shutil.which("caffeinate"):
        cmd = ["caffeinate", "-i", *cmd]
    p = subprocess.Popen(["nohup", *cmd], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    return p.pid


def watchdog_alive(info):
    pid = info.get("watchdog_pid")
    args = subprocess.run(["ps", "-ww", "-o", "args=", "-p", str(pid)], capture_output=True, text=True).stdout if pid else ""
    return WATCHDOG_MARK in args and info["run"] in args  # never a process that merely reuses the PID


def cmd_watchdog(argv):
    """The watchdog itself (`offload _watchdog offload-watchdog <run> <expires> <log>`). It compares wall-clock time
    every 30 seconds instead of one long sleep, because macOS stops sleep timers while the Mac sleeps: a Mac that slept
    past the expiry deletes within a minute of waking. Keeps trying until both lists are readable and empty, for up to
    48 hours after the expiry (a Mac that wakes up offline gets time to reconnect)."""
    _, run, expires, log = argv
    expires, log = int(expires), Path(log)

    def note(msg):
        try:  # the state folder may have been deleted meanwhile; the deletion must not depend on the log
            log.parent.mkdir(parents=True, exist_ok=True)
            with open(log, "a") as f:
                f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")
        except OSError:
            pass

    note(f"watching run {run}, deletes at {datetime.fromtimestamp(expires):%Y-%m-%d %H:%M:%S}")
    while time.time() < expires:
        time.sleep(max(1, min(30, expires - time.time())))
    note("expiry reached, deleting")
    for kind in ("server", "ssh-key"):
        while (found := listing(kind, f"offload-run={run}")) != []:
            if time.time() > expires + 48 * 3600:
                note(f"GAVE UP: {kind} of run {run} may still exist, run `offload clean`")
                sys.exit(1)
            for item in found or []:
                r = hcloud(kind, "delete", str(item["id"]), check=False)
                note(f"{kind} {item['name']}: " + ("deleted" if r.returncode == 0 else f"not deleted: {r.stderr.strip()[:200]}"))
            if found is None:
                note(f"{kind} list not readable: {LAST_ERROR}")
            time.sleep(5 if found else 60)
    note(f"watchdog done: server and key of run {run} are gone")
    with contextlib.suppress(OSError):  # tells clean and the sweeper that this run needs nothing more
        (log.parent / f"gone-{run}").touch()


def stop_watchdog(info):
    pid = info.get("watchdog_pid")
    if pid and watchdog_alive(info):
        try:
            os.killpg(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass


def firewall_ok(fw):
    """Only the firewall offload made itself counts: its label, and inbound exactly SSH and ping."""
    inbound = sorted((x.get("protocol"), x.get("port") or "") for x in fw.get("rules") or [] if x.get("direction") == "in")
    return (fw.get("labels") or {}).get("managed-by") == "offload-to-hetzner" and inbound == [("icmp", ""), ("tcp", "22")]


def ensure_firewall():
    r = hcloud("firewall", "describe", FIREWALL, "-o", "json", check=False)
    if r.returncode == 0:
        if not firewall_ok(json.loads(r.stdout or "{}")):
            die(f"a firewall named {FIREWALL} exists in this project, but it is not the one offload creates (label "
                f"{MANAGED}, inbound only tcp/22 and icmp). Rename or fix it in the Hetzner Console; nothing created.")
        return
    rules = [{"direction": "in", "protocol": "tcp", "port": "22", "source_ips": ["0.0.0.0/0", "::/0"], "description": "ssh"},
             {"direction": "in", "protocol": "icmp", "source_ips": ["0.0.0.0/0", "::/0"], "description": "ping"}]
    try:
        r = subprocess.run(["hcloud", "firewall", "create", "--name", FIREWALL, "--label", MANAGED, "--rules-file", "-"],
                           input=json.dumps(rules), capture_output=True, text=True, timeout=HCLOUD_TIMEOUT)
        err = r.stderr.strip()[:300] if r.returncode else ""
    except subprocess.TimeoutExpired:
        err = f"no answer from the Hetzner API within {HCLOUD_TIMEOUT} s"
    # Whoever made it (this call, or a parallel create that won), only offload's own SSH-only firewall is used.
    r = hcloud("firewall", "describe", FIREWALL, "-o", "json", check=False)
    if r.returncode:
        die(f"firewall {FIREWALL} not created: {err or r.stderr.strip()[:300]}")
    if not firewall_ok(json.loads(r.stdout or "{}")):
        die(f"the firewall {FIREWALL} is not the one offload creates (label {MANAGED}, inbound only tcp/22 and icmp); "
            f"nothing created")


def hourly_price(server_type, location):
    for p in server_type["prices"]:
        if p["location"] == location:
            return float(p["price_hourly"]["gross"])
    return None


def newest_snapshot(base):
    rows = [i for i in hjson("image", "list", "--type", "snapshot", "-l", f"{MANAGED},offload-base={base}") or [] if i["status"] == "available"]
    return max(rows, key=lambda i: i["created"]) if rows else None


def limit_hint(err):
    if "limit" in err.lower():
        return ("\nAn account limit is reached (shared vCPUs, dedicated vCPUs, primary IPs or servers). Limits count across "
                "all projects of the Hetzner account, permanent servers included. Current use and a request form: Hetzner "
                "Console, Limits, \"Request limit increase\". Ask the user before requesting more; a modest request can "
                "be approved automatically within seconds.")
    return ""


def wait_for_ssh(task, info):
    for _ in range(60):
        try:
            if remote(task, info, "true", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30).returncode == 0:
                return
        except subprocess.TimeoutExpired:
            pass
        time.sleep(5)
    die("the server does not answer on SSH after 5 minutes")


def run_setup(task, info, what):
    if what == "docker":
        script = DOCKER_SETUP
    else:
        path = Path(what).expanduser().resolve()  # a link is scanned and sent as its target
        if not path.is_file():
            die(f"setup script {what} not found")
        data = path.read_bytes()  # read once: the scanned bytes are the ones that run
        scan_blob(path.parent, path.name, data)
        script = data.decode(errors="replace")
    say(f"setup: {what}")
    # cat takes the whole script first, so commands in it cannot swallow the rest of it from stdin
    r = remote(task, info, "cat > /root/.offload-setup.sh && bash /root/.offload-setup.sh < /dev/null", input=script, text=True)
    if r.returncode:
        die(f"setup failed (exit {r.returncode})")


def cmd_create(a):
    task = task_name(a.task)
    name, d, ttl = PREFIX + task, state_dir(task), seconds(a.ttl)
    if not MIN_TTL <= ttl <= 24 * 3600:
        die("--ttl must be between 10m and 24h")
    held = lock_or_die(task)  # returned to the caller, which may keep holding it (base create)
    shutil.which("ssh-keygen") or die("ssh-keygen not found (it comes with macOS)")
    if not sweeper_installed():
        warn("the sweeper is not installed (`offload sweeper install`): after a reboot or crash nothing would delete this server")
    if name in {s["name"] for s in hjson("server", "list") or []}:
        die(f"{name} already exists. Use it, or remove it first with `offload rm {task}`. Nothing changed.")
    stype = hjson("server-type", "describe", a.type)
    image = IMAGE
    if a.base:
        snap = newest_snapshot(a.base) or die(f"no base snapshot {a.base!r}; `offload base ls` lists them")
        if snap["architecture"] != stype["architecture"] or stype["disk"] < snap["disk_size"]:
            die(f"base {a.base} is {snap['architecture']} with a {snap['disk_size']:.0f} GB disk, {a.type} is "
                f"{stype['architecture']} with {stype['disk']} GB: pick another type")
        image = str(snap["id"])
    old = read_info(task)
    if old and old.get("run") and not remove_run(task, old["run"]):  # an earlier run's key or state is left over
        die(f"an earlier run of {task} could not be cleaned up; nothing created")
    shutil.rmtree(d, ignore_errors=True)
    d.mkdir(parents=True, mode=0o700)
    subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", name, "-f", str(d / "key")], check=True)
    # The server's host key, made here: cloud-init installs it, known_hosts has it before the first connection.
    subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"{name}-host", "-f", str(d / "hostkey")], check=True)
    host_pub = (d / "hostkey.pub").read_text().strip()
    (d / "known_hosts").write_text(f"{name} {' '.join(host_pub.split()[:2])}\n")
    cloud_config = {"ssh_deletekeys": True, "ssh_keys": {"ed25519_private": (d / "hostkey").read_text(), "ed25519_public": host_pub}}
    (d / "user-data").write_text("#cloud-config\n" + json.dumps(cloud_config) + "\n")
    os.chmod(d / "user-data", 0o600)
    now = int(time.time())
    info = {"task": task, "run": secrets.token_hex(4), "owner": owner(), "type": a.type, "created": now, "expires": now + ttl,
            }
    write_info(task, info)
    # The watchdog starts before anything exists at Hetzner, so no moment leaves a server without one.
    info["watchdog_pid"] = start_watchdog(task, info)
    write_info(task, info)
    time.sleep(1)
    if not watchdog_alive(info):
        die(f"the watchdog did not start (see {d / 'watchdog.log'}); nothing created at Hetzner")
    labels = [MANAGED, f"offload-run={info['run']}", f"offload-task={task}", f"offload-owner={info['owner']}", f"offload-expires={info['expires']}"]
    flags = [x for label in labels for x in ("--label", label)]
    maybe_created = False
    try:
        ensure_firewall()
        info["project"] = project_id() or die("could not tell which Hetzner project this token belongs to (offload's "
                                              "firewall is not readable); nothing created")
        write_info(task, info)
        keyname = f"{name}-{info['run']}"
        hcloud("ssh-key", "create", "--name", keyname, "--public-key-from-file", str(d / "key.pub"), *flags[:6])
        locations = [a.location] if a.location else (by_price(stype) or die(f"{a.type} is not sold in {', '.join(LOCATIONS)}"))
        for loc in locations:
            r = hcloud("server", "create", "--name", name, "--type", a.type, "--image", image, "--location", loc, "--ssh-key", keyname,
                       "--firewall", FIREWALL, "--user-data-from-file", str(d / "user-data"), "--without-ipv6",  # one primary IP
                       *flags, "-o", "json", check=False)                                      # per server, not two
            if r.returncode == 124:  # no answer in time: Hetzner may have made the server all the same
                maybe_created = True
                die(f"server create: {r.stderr.strip()}")
            if r.returncode == 0:
                break
            err = r.stderr.strip()
            if "unavailable" not in err.lower() or loc == locations[-1]:
                die(f"server not created: {err[:400]}{limit_hint(err)}")
            say(f"{a.type} is not available in {loc}, trying the next location")
        srv = json.loads(r.stdout)["server"]
        info.update(id=srv["id"], ip=srv["public_net"]["ipv4"]["ip"], location=loc, price_hourly=hourly_price(stype, loc))
        write_info(task, info)
        # A watchdog that already ran (stalled create) or died would leave this server without a safety net.
        if not watchdog_alive(info) or time.time() > info["expires"] - 5 * 60:
            die("the watchdog is not running or the expiry is too close; deleting the new server")
        price = f"{info['price_hourly']:.4f} EUR/h" if info["price_hourly"] else "price unknown"
        say(f"{name}: {a.type} ({stype['cores']} {stype['cpu_type']} cores, {stype['memory']:.0f} GB) in {loc}, {price}, "
            f"IP {info['ip']}. Watchdog deletes it at {clock(info['expires'])}. Waiting for SSH ...")
        wait_for_ssh(task, info)
        remote(task, info, BOOT, check=True)
        if a.setup:
            run_setup(task, info, a.setup)
        say(f"ready: offload push {task} . | offload exec {task} -- '<command>' | offload rm {task}")
        return held
    except BaseException:
        if maybe_created:
            warn(f"Hetzner did not answer in time, so the server may exist anyway. Its watchdog stays and deletes it at "
                 f"{clock(info['expires'])}; `offload rm {task}` removes it sooner once Hetzner answers again.")
        else:
            warn("create or setup failed, deleting server and key right away")
            remove_run(task, info["run"])
        raise


def delete_all(kind, selector, tries):
    """Deletes every managed server or key matching the selector; True only once the list is readable and empty."""
    for _ in range(tries):
        found = listing(kind, selector)
        if found == []:
            return True
        for item in found or []:
            hcloud(kind, "delete", str(item["id"]), check=False)
        time.sleep(3 if found else 15)
    return listing(kind, selector) == []


def remove_run(task, run):
    """Deletes server and key of one run and checks both lists. Only then the watchdog stops and the local key goes:
    if the deletion fails, the watchdog stays as the fallback. Returns False when something is left; the caller holds
    the task lock."""
    mine = read_info(task)
    sel = f"offload-run={run}"
    if mine and mine.get("run") == run and mine.get("project") and project_id() != mine["project"]:
        # Another project's lists are empty for this run, which proves nothing: removing the local key and watchdog would
        # leave the server billing. When the current token does see the run's server or key, it is this project after all
        # (a new token, or offload's firewall was deleted and made again): go on, and remember the new ID.
        if not (listing("server", sel) or listing("ssh-key", sel)):
            warn(f"{task} was created in another Hetzner project: the current token cannot see its server or key. Remove it "
                 f"with a token of that project. If you know it is gone already, `offload rm --forget {task}` drops the "
                 f"local key and watchdog. Nothing changed.")
            return False
        mine["project"] = project_id()
        write_info(task, mine)
    if not delete_all("server", sel, 4):
        warn(f"ATTENTION: the server of {task} (run {run}) is not deleted or the list is not readable. It keeps billing; "
             f"the watchdog stays active. Retry `offload rm {task}`.")
        return False
    if not delete_all("ssh-key", sel, 3):
        warn(f"server of {task} deleted, but its SSH key is still listed or the list is not readable. The watchdog stays "
             f"active; retry `offload rm {task}` or `offload clean` later.")
        return False
    info = read_info(task)
    if info and info.get("run") == run:
        stop_watchdog(info)
        used = time.time() - info["created"]
        hours = max(1, math.ceil(used / 3600))
        cost = f", billed {hours} h x {info['price_hourly']:.4f} = {hours * info['price_hourly']:.2f} EUR" if info.get("price_hourly") else ""
        say(f"{PREFIX}{task}: server and key deleted and no longer listed; ran {used / 60:.0f} min{cost}")
        shutil.rmtree(state_dir(task), ignore_errors=True)
    else:
        say(f"{PREFIX}{task} (run {run}): server and key deleted and no longer listed")
    return True


def cmd_rm(a):
    ok = True
    for text in a.tasks:
        task = task_name(text)
        held = lock(task)
        if not held:
            warn(f"{task}: skipped, another offload command is working on it right now (a push, get, exec, wait or logs "
                 f"counts too); try again when it is done")
            ok = False
            continue
        info = read_info(task)
        if a.forget:  # only for a server that is known to be gone: Hetzner is not asked
            if info:
                stop_watchdog(info)
            shutil.rmtree(state_dir(task), ignore_errors=True)
            say(f"{task}: local key, state and watchdog dropped without asking Hetzner")
            held.close()
            continue
        runs = {info["run"]} if info and info.get("run") else set()
        keys, rows = listing("ssh-key", f"offload-task={task}"), listing("server", f"offload-task={task}")
        if keys is None or rows is None:
            warn(f"{task}: server or key list not readable; nothing removed, retry")
            ok = False
            held.close()
            continue
        runs |= {x["labels"]["offload-run"] for x in rows + keys if x["labels"].get("offload-run")}
        if not runs:
            say(f"{task}: nothing to remove")
        for run in sorted(runs):
            ok = remove_run(task, run) and ok
        held.close()
    sys.exit(0 if ok else 1)


def expiry(server):
    try:
        return int(server["labels"].get("offload-expires", "0"))
    except ValueError:
        return 0


def clean(everything=False, who=None, grace=0):
    """Deletes servers (all, one owner's, or those more than `grace` seconds past their expiry), then orphaned keys and
    local state of vanished servers. Returns (ok, names of the deleted servers)."""
    now = time.time()
    rows = servers()
    if everything:
        victims = rows
    elif who:
        victims = [s for s in rows if s["labels"].get("offload-owner") == who]
    else:
        victims = [s for s in rows if expiry(s) <= now - grace]
    ok, removed = True, []
    for s in victims:
        task, run = s["labels"].get("offload-task", s["name"].removeprefix(PREFIX)), s["labels"].get("offload-run")
        if not TASK_RE.fullmatch(task):  # labels come from the project, not from this Mac: no path from them
            warn(f"{s['name']}: skipped, its task label {task!r} is not a valid task name")
            ok = False
            continue
        held = lock(task)
        if not held:
            say(f"{s['name']}: skipped, another offload command is working on it")
            continue
        if run:
            done = remove_run(task, run)
            gone = done or listing("server", f"offload-run={run}") == []  # the server can be gone while its key is not
        else:
            done = gone = hcloud("server", "delete", str(s["id"]), check=False).returncode == 0
            say(f"{s['name']}: " + ("deleted (it had no run label)" if done else "NOT deleted"))
        ok = ok and done
        if gone:
            removed.append(s["name"])
        held.close()
    live = {s["labels"].get("offload-run") for s in servers()}
    keys = listing("ssh-key")
    if keys is None:
        warn("key list not readable: orphaned keys and local state left as they are")
        return False, removed
    for k in keys:
        task, run = k["labels"].get("offload-task", ""), k["labels"].get("offload-run")
        if run in live or now - iso_ts(k["created"]) < ORPHAN_AGE or (task and not TASK_RE.fullmatch(task)):
            continue
        held = lock(task) if task else None
        if task and not held:
            continue
        if run and listing("server", f"offload-run={run}") != []:  # re-checked under the lock: a server appeared
            if held:
                held.close()
            continue
        if hcloud("ssh-key", "delete", str(k["id"]), check=False).returncode == 0:
            say(f"orphaned key {k['name']} deleted")
        else:
            warn(f"orphaned key {k['name']} could not be deleted")
            ok = False
        if held:
            held.close()
    keys = listing("ssh-key")
    key_runs = {k["labels"].get("offload-run") for k in keys} if keys is not None else None
    for d in sorted(STATE.iterdir()):
        info = read_info(d.name)
        if not (d.is_dir() and info) or key_runs is None or info.get("run") in live | key_runs or now - info.get("created", 0) < ORPHAN_AGE:
            continue
        gone = (d / f"gone-{info.get('run')}").exists()  # its own watchdog saw server and key deleted, with the right token
        if not gone and info.get("project") and project_id() != info["project"]:  # another project: empty lists prove nothing
            continue
        held = lock(d.name)
        if held:
            sel = f"offload-run={info.get('run')}"
            if read_info(d.name) == info and (gone or (listing("server", sel) == [] and listing("ssh-key", sel) == [])):
                stop_watchdog(info)
                shutil.rmtree(d, ignore_errors=True)
                say(f"local state of {d.name} removed (its server and key no longer exist)")
            held.close()
    return ok, removed


def cmd_clean(a):
    ok, removed = clean(everything=a.all, who=a.owner or (owner() if a.mine else None))
    left = servers()
    say(f"clean done: {len(removed)} servers removed, {len(left)} offload servers left" + (f": {', '.join(s['name'] for s in left)}" if left else ""))
    sys.exit(0 if ok else 1)


# ---------------------------------------------------------------- sweeper (launchd)

SWEEPER_LABEL = "com.github.pipamann.offload-to-hetzner.sweeper"
SWEEPER_PLIST = Path.home() / "Library" / "LaunchAgents" / f"{SWEEPER_LABEL}.plist"
# A stable copy for launchd: plugin installs live in versioned folders that an update removes.
SWEEPER_BIN = STATE / "bin" / "offload"
SWEEP_GRACE = 2 * 60  # the server's own watchdog goes first; the sweeper handles what a reboot or crash left
LOG_MAX = 256 * 1024


def token_from_files():
    """The token variable from the files in $OFFLOAD_SECRET_FILES, read as text, never executed."""
    for path in SECRET_FILES:
        try:
            lines = path.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        found = None
        for line in lines:  # like `source`, the last usable assignment in a file wins
            if m := re.match(rf"\s*(?:export\s+)?{re.escape(TOKEN_VAR)}\s*=(.*)", line):
                try:
                    found = shell_value(m.group(1)) or found  # empty, or a $REFERENCE whose value is unknown: keep looking
                except ValueError:
                    continue
        if found:
            return found
    return None


def hcloud_config():
    try:
        import tomllib
        return tomllib.loads(Path(os.environ.get("HCLOUD_CONFIG", "~/.config/hcloud/cli.toml")).expanduser().read_text())
    except (ImportError, OSError, ValueError):
        return {}


def active_context():
    return os.environ.get("HCLOUD_CONTEXT") or hcloud_config().get("active_context")


def token_from_context():
    """The token of hcloud's active context (`hcloud context create`), as hcloud itself would pick it."""
    active = active_context()
    return next((c.get("token") for c in hcloud_config().get("contexts", []) if c.get("name") == active and c.get("token")), None)


def resolve_token():
    return os.environ.get(TOKEN_VAR) or token_from_files() or token_from_context()


def use_token(token):
    """Hands the token to hcloud and the watchdog through the environment, never on a command line."""
    os.environ["HCLOUD_TOKEN"] = token


def project_id():
    """Which Hetzner project the current token belongs to, told by the ID of offload's firewall there (IDs are unique
    across Hetzner; the firewall is made once per project and kept). A new token for the same project gives the same
    ID; None when the firewall is missing or the API does not answer."""
    if not _PROJECT:
        r = hcloud("firewall", "describe", FIREWALL, "-o", "json", check=False)
        if r.returncode or not r.stdout.strip():
            return None  # not cached: the firewall may exist a moment later (create makes it)
        _PROJECT.append(str(json.loads(r.stdout)["id"]))
    return _PROJECT[0]


def version_of(path):
    try:
        m = re.search(r'^VERSION = "([\d.]+)"', path.read_text(errors="ignore"), re.M)
    except OSError:
        return None
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


def sweeper_installed():
    """The launchd job exists and runs the stable copy, which exists."""
    try:
        args = plistlib.loads(SWEEPER_PLIST.read_bytes()).get("ProgramArguments") or []
    except (OSError, ValueError):
        return False
    return str(SWEEPER_BIN) in args and SWEEPER_BIN.exists()


def install_bin():
    SWEEPER_BIN.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = SWEEPER_BIN.with_name(f".offload.{os.getpid()}")
    shutil.copyfile(Path(__file__).resolve(), tmp)
    os.chmod(tmp, 0o755)
    tmp.replace(SWEEPER_BIN)


def refresh_bin():
    """After a plugin update, the next offload command brings the sweeper's copy up to date (never downgrades it)."""
    here, there = tuple(int(x) for x in VERSION.split(".")), version_of(SWEEPER_BIN)
    if there is not None and here > there and sweeper_installed():
        install_bin()


def rotate(path):
    try:
        if path.stat().st_size > LOG_MAX:
            path.replace(path.with_name(path.name + ".1"))
    except OSError:
        pass


def notify(message):
    """macOS notification; the text is passed as an argument, never spliced into the AppleScript."""
    if not shutil.which("osascript"):
        return "no osascript"
    return subprocess.run(["osascript", "-e", "on run argv", "-e", 'display notification (item 1 of argv) with title "offload sweeper"',
                           "-e", "end run", message], capture_output=True).returncode


def cmd_sweep(a):
    """Run by launchd at login and at :00, :15, :30 and :45 (`offload sweeper install`); a tick missed during sleep runs
    on wake. Deletes servers more than 2 minutes past their expiry, orphaned keys and stale local state: what a watchdog
    killed by a reboot or crash leaves behind. Notifies when it had to delete a server, and when cleanup keeps failing
    (two runs in a row, only if offload servers may exist, at most every 6 hours)."""
    log, state_file = STATE / "sweeper.log", STATE / "sweeper-state.json"
    rotate(log)
    rotate(STATE / "sweeper-launchd.log")
    try:
        st = json.loads(state_file.read_text())
    except (OSError, ValueError):
        st = {}
    out, ok, removed, left, seen = io.StringIO(), False, [], [], None
    token = resolve_token()
    if not token:
        out.write(f"no token: ${TOKEN_VAR} is not in the files of OFFLOAD_SECRET_FILES and hcloud has no active context\n")
    else:
        use_token(token)
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
                ok, removed = clean(grace=SWEEP_GRACE)
                rows = servers()
                left = [s["name"] for s in rows if expiry(s) <= time.time() - SWEEP_GRACE]
                for d in STATE.iterdir():  # expired runs of another project: this token cannot delete them, so say so
                    info = read_info(d.name) if d.is_dir() else None
                    if (info and info.get("expires", 0) <= time.time() - SWEEP_GRACE and info.get("project")
                            and info["project"] != project_id() and not (d / f"gone-{info.get('run')}").exists()
                            and not watchdog_alive(info)):
                        left.append(f"{PREFIX}{d.name} (another Hetzner project, not reachable with the sweeper's token)")
                seen = len(rows)
        except SystemExit:  # die() inside: a list not readable, hcloud missing ...
            ok = False
        except Exception as err:  # noqa: BLE001 (logged, and counted as a failed run)
            out.write(f"error: {err!r}\n")
            ok = False
    ok = ok and not left
    now = time.time()
    local_state = any((d / "info.json").exists() for d in STATE.iterdir() if d.is_dir())
    if seen is not None:  # whenever the list was readable, also on a failed run
        st["servers_seen"] = seen
    if ok:
        st["failures"] = 0
        status = f"ok, deleted {', '.join(removed)}" if removed else "ok, nothing to do"
    else:
        st["failures"] = st.get("failures", 0) + 1
        status = f"FAILED ({st['failures']} runs in a row)" + (f", still past expiry: {', '.join(left)}" if left else "")
    message = f"Deleted {', '.join(removed)}: past its expiry and its watchdog was gone (reboot or crash?)." if removed else ""
    if (not ok and st["failures"] >= 2 and (local_state or left or st.get("servers_seen")) and now - st.get("notified", 0) > 6 * 3600):
        message += (" " if message else "") + (f"Still billing: {', '.join(left)}. " if left else "") + \
            f"Cleanup keeps failing; see {log}"
        st["notified"] = now
    if message:
        status += f"; notified (osascript {notify(message)})"
    details = " | ".join(line.strip() for line in out.getvalue().splitlines() if line.strip())
    with open(log, "a") as f:
        f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {status}" + (f" :: {details}" if details and (removed or not ok) else "") + "\n")
    state_file.write_text(json.dumps(st))
    sys.exit(0 if ok else 1)


# The Python that installed the sweeper first, then any 3.11+ on the PATH: survives Homebrew moving to a new Python
# version, and never falls back to macOS's old system Python.
PICK_PYTHON = r"""for p in "$0" python3 python3.14 python3.13 python3.12 python3.11; do
  command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null &&
    exec "$p" -I "$1" sweep
done
echo "offload sweeper: no Python 3.11 or newer found" >&2
osascript -e 'display notification "No Python 3.11 or newer found: expired servers are not cleaned up" with title "offload sweeper"'
exit 1"""


def sweeper_plist():
    """Made on this Mac at install time: its Python, its hcloud, its state folder. Names of settings, never the token."""
    py = shutil.which("python3") or sys.executable
    hc = shutil.which("hcloud") or die("hcloud not found on PATH; install it first (brew install hcloud)")
    dirs = [str(Path(sys.executable).parent), str(Path(py).parent), str(Path(hc).parent),
            "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
    env = {"PATH": ":".join(dict.fromkeys(dirs)), "OFFLOAD_STATE_DIR": str(STATE), "OFFLOAD_TOKEN_VAR": TOKEN_VAR}
    if SECRET_FILES:
        env["OFFLOAD_SECRET_FILES"] = ":".join(str(p.resolve()) for p in SECRET_FILES)  # launchd runs from /
    for name in ("HCLOUD_CONFIG", "HCLOUD_CONTEXT"):
        if os.environ.get(name):
            env[name] = os.environ[name]
    if "HCLOUD_CONTEXT" not in env and not token_from_files() and active_context():
        env["HCLOUD_CONTEXT"] = active_context()  # pinned: switching contexts later must not move the sweeper elsewhere
    return {
        "Label": SWEEPER_LABEL,
        "ProgramArguments": ["/bin/sh", "-c", PICK_PYTHON, sys.executable, str(SWEEPER_BIN)],
        "EnvironmentVariables": env,
        "RunAtLoad": True,
        # Calendar ticks, not StartInterval: launchd runs a calendar tick missed during sleep once on wake, but drops
        # missed interval ticks (man launchd.plist). So a Mac that slept past an expiry cleans up right after waking.
        "StartCalendarInterval": [{"Minute": m} for m in (0, 15, 30, 45)],
        "ProcessType": "Background",
        "StandardOutPath": str(STATE / "sweeper-launchd.log"),
        "StandardErrorPath": str(STATE / "sweeper-launchd.log"),
    }


def cmd_sweeper(a):
    """Installs, removes or shows the launchd job that runs `offload sweep`; install and uninstall are idempotent."""
    domain = f"gui/{os.getuid()}"
    previous = SWEEPER_PLIST.read_bytes() if SWEEPER_PLIST.exists() else None
    if a.action == "install":  # everything that can fail comes first, so a failed reinstall keeps the old job running
        if not (token_from_files() or token_from_context()):
            die(f"the sweeper runs without your shell's environment, so it cannot see ${TOKEN_VAR} there. Put the token "
                f"into a file listed in OFFLOAD_SECRET_FILES (a line {TOKEN_VAR}=...), or into an hcloud context "
                f"(`hcloud context create <name>`), then install again. Nothing changed.")
        new_plist = plistlib.dumps(sweeper_plist())
        install_bin()
    if a.action in ("install", "uninstall"):
        subprocess.run(["launchctl", "bootout", f"{domain}/{SWEEPER_LABEL}"], capture_output=True)
        SWEEPER_PLIST.unlink(missing_ok=True)
    if a.action == "install":
        SWEEPER_PLIST.parent.mkdir(parents=True, exist_ok=True)
        SWEEPER_PLIST.write_bytes(new_plist)
        log = STATE / "sweeper.log"

        def stamp():  # inode and size: the first run may rotate the log, which makes a new, shorter file
            try:
                st = log.stat()
                return st.st_ino, st.st_size
            except OSError:
                return None

        before = stamp()
        for attempt in range(5):  # bootstrap right after bootout can fail with "Input/output error" for a moment
            r = subprocess.run(["launchctl", "bootstrap", domain, str(SWEEPER_PLIST)], capture_output=True, text=True)
            if r.returncode == 0:
                break
            time.sleep(1)
        else:
            if previous:
                SWEEPER_PLIST.write_bytes(previous)
                subprocess.run(["launchctl", "bootstrap", domain, str(SWEEPER_PLIST)], capture_output=True)
            die(f"launchctl bootstrap failed: {r.stderr.strip()}" + ("; the previous job is running again" if previous else ""))
        for _ in range(60):  # RunAtLoad starts one round right away: wait for its log line to prove the job really works
            if stamp() not in (None, before):
                break
            time.sleep(1)
        else:
            die(f"the sweeper is installed but wrote nothing within a minute; check {STATE / 'sweeper-launchd.log'}")
        last = log.read_text().splitlines()[-1]
        say(f"sweeper installed: runs `offload sweep` at login and at :00, :15, :30, :45; first run: {last}")
        if " FAILED" in last:
            die(f"the first run failed; see {log}")
    elif a.action == "uninstall":
        SWEEPER_BIN.unlink(missing_ok=True)
        say("sweeper uninstalled")
    else:
        r = subprocess.run(["launchctl", "print", f"{domain}/{SWEEPER_LABEL}"], capture_output=True, text=True)
        if r.returncode:
            say("sweeper not installed: `offload sweeper install`")
        else:
            say("sweeper installed: " + ", ".join(line.strip() for line in r.stdout.splitlines()  # top level only (one tab)
                                                  if re.match(r"\t(state|runs|last exit code) =", line)))
        try:
            runs = (STATE / "sweeper.log").read_text().splitlines()[-5:]
        except OSError:
            runs = []
        say("last runs:\n" + "\n".join(runs) if runs else "no runs logged yet")


def cmd_ls(a):
    now = time.time()
    rows = servers()
    for s in sorted(rows, key=lambda s: s["created"]):
        labels, loc = s["labels"], (s.get("location") or {}).get("name") or s["datacenter"]["location"]["name"]
        price = hourly_price(s["server_type"], loc) or 0
        hours = max(1, math.ceil((now - iso_ts(s["created"])) / 3600))
        expires = int(labels.get("offload-expires", "0") or 0)
        here = "key here" if (read_info(s["name"].removeprefix(PREFIX)) or {}).get("run") == labels.get("offload-run") else "key elsewhere"
        say(f"{s['name']:<34} {s['server_type']['name']:<6} {loc:<5} {s['status']:<9} owner {labels.get('offload-owner', '?'):<12} "
            f"expires {clock(expires) if expires else '?':<16} {hours} h so far = {hours * price:.2f} EUR, {here}")
    if not rows:
        say("no offload servers")


def cmd_types(a):
    """Live prices; without --location, each type at its cheapest EU location (where create would put it)."""
    rows = []
    for t in hjson("server-type", "list"):
        where = {x["name"]: x for x in t.get("locations", [])}
        sold = [loc for loc in ([a.location] if a.location else by_price(t)) if loc in where and not where[loc].get("deprecation")]
        if t.get("deprecated") or not sold or hourly_price(t, sold[0]) is None:
            continue
        rows.append((hourly_price(t, sold[0]), sold[0], t))
    say(f"{'type':<7}{'cores':>6} {'cpu':<10}{'RAM':>6}{'disk':>7}  arch  EUR/h  where  (live, Hetzner API, your account's prices)")
    for price, loc, t in sorted(rows, key=lambda r: r[0]):
        say(f"{t['name']:<7}{t['cores']:>6} {t['cpu_type']:<10}{t['memory']:>4.0f}GB{t['disk']:>5}GB  {t['architecture']:<5} {price:.4f} {loc}")


