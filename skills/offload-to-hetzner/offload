TASK_RE = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?")


def task_name(text):
    task = text.removeprefix(PREFIX)
    if not TASK_RE.fullmatch(task):
        die(f"task {text!r}: use 1-40 lowercase letters, digits and dashes")
    return task


def job_name(text):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,60}", text):
        die(f"job {text!r}: use letters, digits, dot, dash and underscore")
    return text


def owner():
    """cc-<session> inside Claude Code (it exports CLAUDE_CODE_SESSION_ID to its shells), else $OFFLOAD_OWNER, else the
    login name: outside Claude Code, `clean --mine` then means every server this user created on this Mac."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    who = os.environ.get("OFFLOAD_OWNER") or (f"cc-{sid[:8]}" if sid else os.environ.get("USER", "unknown"))
    return re.sub(r"[^a-z0-9-]", "-", who.lower())[:63].strip("-") or "unknown"


def seconds(text):
    m = re.fullmatch(r"(\d+)([mh])", text)
    if not m:
        die(f"duration {text!r}: use for example 90m or 4h")
    return int(m.group(1)) * (60 if m.group(2) == "m" else 3600)


def clock(ts):
    return datetime.fromtimestamp(ts).strftime("%H:%M" if abs(ts - time.time()) < 20 * 3600 else "%Y-%m-%d %H:%M")


def iso_ts(text):
    return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()


def state_dir(task):
    return STATE / task


def read_info(task):
    f = state_dir(task) / "info.json"
    try:
        return json.loads(f.read_text())
    except (OSError, ValueError):
        return None


def write_info(task, info):
    f = state_dir(task) / "info.json"
    f.with_suffix(".tmp").write_text(json.dumps(info, indent=1))
    f.with_suffix(".tmp").replace(f)


def need(task):
    info = read_info(task)
    if not info or not info.get("ip"):
        die(f"no server for task {task} on this Mac. `offload ls` lists the servers; the SSH key exists only where create ran.")
    return info


def ssh_args(task, info):
    # The host key was made on this Mac and handed to the server by cloud-init, so it is checked strictly from the
    # first connection on; the alias keeps it independent of the IP, which Hetzner reuses.
    d = state_dir(task)
    return ["ssh", "-F", "/dev/null", "-i", str(d / "key"), "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=yes", "-o", f'UserKnownHostsFile="{d / "known_hosts"}"', "-o", "CheckHostIP=no",
            "-o", f"HostKeyAlias={PREFIX}{task}", "-o", "HostKeyAlgorithms=ssh-ed25519",
            "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=4",
            "-o", "LogLevel=ERROR", "--", f"root@{info['ip']}"]  # after --, a command starting with - is no ssh option


def remote_line(script, *args):
    """A bash script for the server; the arguments arrive as $1, $2 ... without any local shell expansion."""
    return " ".join(["bash", "-c", shlex.quote(script), "offload", *map(shlex.quote, args)])


def remote(task, info, script, *args, **kw):
    return subprocess.run([*ssh_args(task, info), remote_line(script, *args)], **kw)


