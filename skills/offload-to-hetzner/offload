SAFE_PUSH_DIR = re.compile(r"/(root|srv|opt|tmp|mnt|home/[a-z_][a-z0-9_-]*)(/[A-Za-z0-9_][A-Za-z0-9._-]*)+")


def cmd_push(a):
    task = task_name(a.task)
    info = use(task)
    local = Path(a.local).resolve()
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", unicodedata.normalize("NFKD", local.name).encode("ascii", "ignore").decode()).strip(".-")
    remote_dir = a.remote or f"/root/work/{slug or 'project'}"  # a folder called "My Project" goes to /root/work/My-Project
    if not SAFE_PUSH_DIR.fullmatch(remote_dir) or remote_dir.startswith(JOBS):
        die(f"remote folder {remote_dir!r}: push replaces it, so use a folder such as /root/work/<name>")
    check_outgoing(remote_dir, *KEEP)
    r = subprocess.run(["git", "-C", str(local), "ls-files", "-z", "--cached", "--others", "--exclude-standard"], capture_output=True)
    if r.returncode:
        die(f"{local} is not in a git work tree; use `offload put` for plain folders")
    files, skipped = [], []
    for rel in sorted({os.fsdecode(x) for x in r.stdout.split(b"\0") if x}):
        p = local / rel
        if p.is_symlink() or p.is_file():
            files.append(rel)
        elif p.is_dir():
            skipped.append(rel)  # submodules and nested repositories
    if skipped:
        say(f"not pushed (submodules or nested repositories): {', '.join(skipped[:10])}")
    archive = pack(local, files, a.allow)
    try:
        with open(archive, "rb") as f:
            r = remote(task, info, PUSH, remote_dir, *KEEP, stdin=f)
    finally:
        os.unlink(archive)
    if r.returncode:
        die(f"push failed (ssh {r.returncode}); the remote folder may be the old or the new tree, push again")


def cmd_put(a):
    task = task_name(a.task)
    info = use(task)
    check_outgoing(a.remote)
    src = Path(a.local).expanduser()
    if src.is_file():
        src = src.resolve()  # a link is scanned and sent as its target
        archive = pack(src.parent, [src.name], a.allow)
        try:
            with open(archive, "rb") as f:  # unpacked beside the target, then moved into place with its mode
                r = remote(task, info, 'set -e; mkdir -p "$(dirname "$1")"; d=$(mktemp -d "$(dirname "$1")/.offload-put.XXXXXX"); '
                           'trap \'rm -rf "$d"\' EXIT; tar -xzf - -C "$d" --no-same-owner --warning=no-unknown-keyword '
                           '--warning=no-timestamp; mv -f -- "$d/$2" "$1"', a.remote, src.name, stdin=f)
        finally:
            os.unlink(archive)
        if r.returncode:
            die(f"put failed (exit {r.returncode})")
    elif src.is_dir():
        files = sorted(str(p.relative_to(src)) for p in src.rglob("*") if p.is_file() or p.is_symlink())
        dirs = sorted(str(p.relative_to(src)) for p in src.rglob("*") if p.is_dir() and not p.is_symlink())
        archive = pack(src.resolve(), files, a.allow, dirs=dirs)  # the folders too, empty ones included
        try:
            with open(archive, "rb") as f:
                r = remote(task, info, 'mkdir -p "$1" && tar -xzf - -C "$1" --no-same-owner --warning=no-unknown-keyword '
                           '--warning=no-timestamp', a.remote, stdin=f)
        finally:
            os.unlink(archive)
        if r.returncode:
            die(f"put failed (ssh {r.returncode})")
    else:
        die(f"{src} not found")
    say(f"put {src} -> {a.remote}")


GIT_CONTROL = {".gitattributes", ".gitmodules", ".lfsconfig", ".gitconfig"}  # can steer git commands run here later


def git_like(name):
    """True for .git in any spelling the Mac's file system treats as .git (APFS ignores case and Unicode normalization),
    and for any name with invisible format characters, which could disguise one."""
    if any(unicodedata.category(c) == "Cf" for c in name):
        return True
    return unicodedata.normalize("NFC", name).casefold() == ".git"


def fold(name):
    """A name the way the Mac's file system compares it (APFS ignores case and Unicode normalization)."""
    return unicodedata.normalize("NFC", name).casefold()


def names_in(path):
    try:
        return {fold(c.name) for c in path.iterdir()}
    except OSError:
        return set()


def git_dir_names(names):
    """git treats a folder as a repository (and honors its config, e.g. an fsmonitor command, for any git command
    run inside it) when it holds HEAD with objects and refs, or HEAD with commondir (a worktree's admin folder)."""
    return {"head", "objects", "refs"} <= names or {"head", "commondir"} <= names


def check_get_target(src, dest):
    """Results from the server must not plant or complete a git repository on the Mac."""
    for p in [src, *src.rglob("*")]:
        if fold(p.name) in ("head", "commondir", "gitdir"):
            die(f"the server sent {p.name!r}, a name git uses for its own files; nothing copied")
    for anc in [dest, *dest.parents]:
        if git_like(anc.name) or (anc.is_dir() and git_dir_names(names_in(anc))):
            die(f"{dest} is inside a git repository folder ({anc}); get does not write there. Nothing copied.")
    if src.is_dir():  # after the merge, each folder holds its local names plus the received ones
        for p in [src, *(q for q in src.rglob("*") if q.is_dir())]:
            if git_dir_names(names_in(p) | names_in(dest / p.relative_to(src))):
                die(f"merging into {dest / p.relative_to(src)} would make it look like a git repository; nothing copied")


def cmd_get(a):
    task = task_name(a.task)
    info = use(task)
    check_outgoing(a.remote)
    expected = PurePosixPath(a.remote.rstrip("/")).name  # the only top-level name accepted from the server
    if expected in ("", ".", ".."):
        die("get needs the path of a file or folder on the server, not /, . or ..")
    # Folders above the destination are the user's choice and may be links (/tmp is one on macOS): resolve them, so
    # the checks below see the real place. The destination itself and everything below it must not be a link.
    given = Path(os.path.abspath(Path(a.local).expanduser()))
    dest = Path(os.path.realpath(given.parent)) / given.name
    if dest.is_symlink():
        die(f"{given} is a symlink; get does not write through links. Nothing copied.")
    stage = Path(tempfile.mkdtemp(prefix="get-", dir=state_dir(task)))
    try:
        proc = subprocess.Popen([*ssh_args(task, info), remote_line(GET, a.remote)], stdout=subprocess.PIPE)
        skipped, total, entries = 0, 0, 0
        try:
            # The server ran foreign code and chooses every name in the archive: only plain files and folders below the
            # requested name, no links or devices, no .git (hooks would run here), no hidden files unless --hidden,
            # and no more than OFFLOAD_GET_MAX_GB in total.
            with tarfile.open(fileobj=proc.stdout, mode="r|gz") as archive:
                for member in archive:
                    parts = PurePosixPath(member.name).parts
                    if not parts or parts[0] != expected:
                        proc.kill()
                        die(f"the server sent {member.name!r}, which is not inside {expected!r}; nothing copied")
                    if any(git_like(p) or fold(p) in GIT_CONTROL for p in parts) or (not a.hidden and any(p.startswith(".") for p in parts)):
                        proc.kill()
                        die(f"the server sent {member.name!r}: .git in any spelling, git's control files (.gitattributes, "
                            f".gitmodules, .lfsconfig ...) and names with invisible characters are always refused, other "
                            f"hidden files only with --hidden; nothing copied")
                    entries += 1  # every entry counts, also the skipped ones: their metadata costs memory too
                    if not (member.isfile() or member.isdir()) or member.issparse():  # sparse: declared size and writes can differ
                        skipped += 1
                    else:
                        total += member.size
                    if total > GET_MAX_BYTES or entries > GET_MAX_ENTRIES:
                        proc.kill()
                        die(f"get {a.remote}: more than {GET_MAX_BYTES / 1e9:.0f} GB or {GET_MAX_ENTRIES} entries; nothing copied (OFFLOAD_GET_MAX_GB raises the size limit)")
                    if not (member.isfile() or member.isdir()) or member.issparse():
                        continue
                    try:
                        archive.extract(member, stage, filter="data")
                    except tarfile.FilterError:
                        skipped += 1
        except tarfile.ReadError:
            proc.kill()
            proc.wait()
            die(f"get {a.remote}: nothing received")
        if proc.wait():
            die(f"get {a.remote} failed (ssh {proc.returncode}); nothing copied")
        items = list(stage.iterdir())
        if len(items) != 1 or items[0].name != expected:
            die("unexpected archive content; nothing copied")
        src = items[0]
        for p in [src, *src.rglob("*")]:  # results are data: no execute bits from the server
            os.chmod(p, 0o755 if p.is_dir() else 0o644)
        # Where code on the Mac starts by itself, or everything else lives: never a target, not even with --merge.
        # Compared the way APFS compares names (case and Unicode form ignored): ~/library is ~/Library.
        def key(p):
            return tuple(fold(x) for x in p.parts)

        home, target = key(Path(os.path.realpath(Path.home()))), key(dest)
        no_go = [home + (fold("Library"),), home + (fold("Applications"),)] + [key(Path(x)) for x in ("/Library", "/System", "/Applications")]
        if home[:len(target)] == target or any(target[:len(n)] == n for n in no_go):
            die(f"{dest}: get does not write into the home folder itself, the folders above it, or a Library or "
                f"Applications folder. Pick a results folder, for example ./offload-results. Nothing copied.")

        def occupied(p):
            return p.is_file() or (p.is_dir() and any(p.iterdir()))

        # Without --merge, nothing that exists here is merged into or replaced: what the server sends lands in a new or
        # empty place (like cp -r, an existing folder receives a folder result as a subfolder of its own name).
        if src.is_dir():
            if dest.exists() and not dest.is_dir():
                die(f"{dest} is a file and the server sent a folder; nothing copied")
            if occupied(dest) and not a.merge:
                dest = dest / src.name
                if dest.is_symlink() or occupied(dest):
                    die(f"{dest} already exists; get does not merge into existing files unless you pass --merge. Nothing copied.")
            parts = [p.relative_to(src) for p in src.rglob("*")]
        else:
            if dest.is_dir() and not dest.is_symlink():
                dest = dest / src.name
            if dest.is_dir() and not dest.is_symlink():
                die(f"{dest} is a folder and the server sent a file; nothing copied")
            if (dest.exists() or dest.is_symlink()) and not a.merge:
                die(f"{dest} already exists; get replaces files only with --merge. Nothing copied.")
            parts = []
        # Never write through a link that already exists here: the server could aim it at any file on the Mac.
        if dest.is_symlink():
            die(f"{dest} is a symlink; get does not write through links. Nothing copied.")
        for rel in parts:
            probe = dest
            for part in rel.parts:
                probe = probe / part
                if probe.is_symlink():
                    die(f"{probe} is a symlink; get does not write through links. Nothing copied.")
        check_get_target(src, dest)
        count = sum(1 for p in src.rglob("*") if p.is_file()) if src.is_dir() else 1
        dest.parent.mkdir(parents=True, exist_ok=True)
        if a.merge:  # merging on purpose: into what is there, file by file
            if src.is_dir():
                shutil.copytree(src, dest, dirs_exist_ok=True)
            else:
                shutil.copy2(src, dest)
        else:
            # Copied beside the destination, then put in place in one step: no half tree when something fails, and a
            # destination that another get filled meanwhile is never written into.
            tmp = dest.parent / f".{dest.name}.offload-get-{os.getpid()}"
            try:
                if src.is_dir():
                    shutil.copytree(src, tmp)
                    try:
                        os.rename(tmp, dest)  # takes the place of a missing or empty folder only
                    except OSError:
                        die(f"{dest} was filled meanwhile; nothing copied")
                else:
                    shutil.copy2(src, tmp)
                    try:
                        os.link(tmp, dest)  # fails when something appeared there meanwhile
                    except FileExistsError:
                        die(f"{dest} appeared meanwhile; nothing copied")
                    except OSError:  # no hard links on this file system (exFAT ...): create it exclusively instead
                        try:
                            with open(tmp, "rb") as fi, open(dest, "xb") as fo:
                                shutil.copyfileobj(fi, fo)
                        except FileExistsError:
                            die(f"{dest} appeared meanwhile; nothing copied")
                        shutil.copystat(tmp, dest)
            finally:
                if tmp.is_dir() and not tmp.is_symlink():
                    shutil.rmtree(tmp, ignore_errors=True)
                else:
                    tmp.unlink(missing_ok=True)
        say(f"got {count} files into {dest}" + (f" ({skipped} links or special entries skipped)" if skipped else ""))
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def cmd_exec(a):
    task = task_name(a.task)
    info = use(task)
    command = " ".join(a.command).strip()
    if not command:
        die("no command given; put it after --, as one single-quoted string")
    check_outgoing(command, a.cwd, a.detach)
    if a.detach:
        r = remote(task, info, DETACH, job_name(a.detach), a.cwd or "/root", input=command + "\n", text=True)
        sys.exit(r.returncode)
    if a.cwd:  # `cd x && a; b` would still run b in the home folder when cd fails: stop the whole command instead
        command = f"cd -- {shlex.quote(a.cwd)} || exit 1\n{command}"
    r = subprocess.run([*ssh_args(task, info), command])
    if r.returncode == 255:
        warn("exit 255: SSH failed (the command may or may not have run) or the command itself exited 255. Use --detach for long jobs.")
    sys.exit(r.returncode)


def show_tail(task, info, job, n):
    remote(task, info, 'tail -n "$2" "$1"', f"{JOBS}/{job}.log", str(n), check=False)


def cmd_wait(a):
    task, job = task_name(a.task), job_name(a.job)
    info = use(task)
    start = time.time()
    # 15 minutes before the expiry, so get still has time; less on a short-lived server (a 10m server gets 2.5 minutes)
    deadline = info["expires"] - min(WAIT_MARGIN, (info["expires"] - info["created"]) // 4)
    if a.timeout:
        deadline = min(deadline, start + seconds(a.timeout))
    beat = start
    while True:
        try:
            r = remote(task, info, POLL, job, capture_output=True, text=True, timeout=60)
            state = r.stdout.strip() if r.returncode == 0 else ""
        except subprocess.TimeoutExpired:
            state = ""
        if state.startswith("exit "):
            code = int(state.split()[1])
            break
        if state == "missing":
            die(f"no job {job} on {PREFIX}{task}")
        if state == "dead":
            show_tail(task, info, job, 30)
            die(f"job {job} ended without an exit status (killed, or the server rebooted)")
        now = time.time()
        if now >= deadline:
            show_tail(task, info, job, 30)
            die(f"stopped waiting at {clock(now)}; job {job} is still running. The server expires at {clock(info['expires'])}: "
                f"get the results now, or wait again with a later --timeout.", 124)
        if now - beat >= 300:
            say(f"{(now - start) / 60:.0f} min: " + (state.replace("running", "running, last log line:", 1) if state else "server not reachable, retrying"))
            beat = now
        time.sleep(15)
    show_tail(task, info, job, 30)
    say(f"job {job} finished with exit status {code} after {(time.time() - start) / 60:.0f} min of waiting")
    sys.exit(code)


def cmd_logs(a):
    task, job = task_name(a.task), job_name(a.job)
    info = use(task)
    if a.follow:
        r = remote(task, info, 'tail -n "$2" -f --pid="$(cut -d" " -f1 "$1.pid")" "$1.log"', f"{JOBS}/{job}", str(a.n))
    else:
        r = remote(task, info, 'tail -n "$2" "$1.log"', f"{JOBS}/{job}", str(a.n))
    sys.exit(r.returncode)


# ---------------------------------------------------------------- base snapshots

def snapshots(selector=""):
    return hjson("image", "list", "--type", "snapshot", "-l", MANAGED + ("," + selector if selector else "")) or []


def listing_images(selector):
    """Like snapshots(), but None instead of exiting when the list is not readable (used during cleanup)."""
    r = hcloud("image", "list", "--type", "snapshot", "-l", f"{MANAGED},{selector}", "-o", "json", check=False)
    return None if r.returncode else (json.loads(r.stdout or "null") or [])


def cmd_base(a):
    if a.action == "ls":
        rows = snapshots()
        for i in sorted(rows, key=lambda i: i["created"]):
            size = i.get("image_size") or 0
            say(f"{i['labels'].get('offload-base', '?'):<16} id {i['id']:<10} {i['created'][:16]}  {i['architecture']}  disk {i['disk_size']:.0f} GB, "
                f"stored {size:.2f} GB = {size * SNAPSHOT_EUR_GB_MONTH:.2f} EUR/month  {i['status']}")
        if not rows:
            say("no base snapshots")
        return
    base = a.base or die("name the base")
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,28}[a-z0-9])?", base):
        die(f"base {base!r}: use 1-30 lowercase letters, digits and dashes")
    if a.action == "rm":
        rows = snapshots(f"offload-base={base}")
        for i in rows:
            hcloud("image", "delete", str(i["id"]))
        say(f"{len(rows)} snapshots of base {base} deleted" if rows else f"no snapshot of base {base}")
        return
    task = f"base-{base}"
    # create's task lock stays held until the builder is gone, so no rm or clean can step in between
    held = cmd_create(argparse.Namespace(task=task, type=a.type, location=a.location, ttl="2h", base=None, setup=a.setup))  # noqa: F841
    info = need(task)
    try:
        remote(task, info, SEAL, check=True)
        for _ in range(36):
            time.sleep(5)
            if hjson("server", "describe", str(info["id"]))["status"] == "off":
                break
        else:
            hcloud("server", "poweroff", str(info["id"]))
        say("creating the snapshot (a few minutes) ...")
        try:
            hcloud("server", "create-image", "--type", "snapshot", "--description", f"offload base {base} {datetime.now():%Y-%m-%d}",
                   "--label", MANAGED, "--label", f"offload-base={base}", "--label", f"offload-run={info['run']}", str(info["id"]))
        except BaseException:
            # Hetzner may have accepted the snapshot although hcloud failed: a half-made snapshot must not bill unnoticed.
            half = listing_images(f"offload-run={info['run']}")
            if half is None:
                warn(f"snapshot list not readable: check `offload base ls` for a half-made snapshot of {base}")
            for i in half or []:
                if hcloud("image", "delete", str(i["id"]), check=False).returncode:
                    warn(f"failed snapshot {i['id']} could not be deleted: remove it with `offload base rm {base}`")
            raise
    finally:
        builder_gone = remove_run(task, info["run"])
        if not builder_gone:
            warn(f"the builder {PREFIX}{task} is still listed; run `offload rm {task}`")
    rows = snapshots(f"offload-base={base}")
    new = [i for i in rows if i["labels"].get("offload-run") == info["run"]]
    if not new:
        die("snapshot not found after creation")
    for old in rows:
        if old["id"] != new[0]["id"]:
            hcloud("image", "delete", str(old["id"]))
            say(f"older snapshot {old['id']} of base {base} deleted")
    size = new[0].get("image_size") or 0
    say(f"base {base}: snapshot {new[0]['id']}, stored {size:.2f} GB = about {size * SNAPSHOT_EUR_GB_MONTH:.2f} EUR/month while it exists. "
        f"Start servers from it with `offload create <task> --from {base}`.")
    if not builder_gone:
        die(f"the builder {PREFIX}{task} may still bill: run `offload rm {task}`")


# ---------------------------------------------------------------- main

def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `offload ... | head` ends quietly
    if sys.argv[1:2] == ["_watchdog"]:  # started by create; the token comes in through the environment
        return cmd_watchdog(sys.argv[2:])
    if sys.version_info < (3, 11) or not hasattr(tarfile, "data_filter"):
        msg = f"needs Python 3.11 or newer (this is {sys.version.split()[0]} at {sys.executable}); for example `brew install python`"
        if sys.argv[1:2] == ["sweep"]:
            notify(f"offload sweeper cannot run: {msg}")
        die(msg)
    if sys.platform != "darwin":
        die("macOS only for now: the watchdog and the sweeper rely on caffeinate and launchd. Linux support is welcome as a pull request.")
    p = argparse.ArgumentParser(prog="offload", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("types")
    s.add_argument("--location")
    s = sub.add_parser("create")
    s.add_argument("task")
    s.add_argument("--type", default=DEFAULT_TYPE)
    s.add_argument("--location")
    s.add_argument("--ttl", default="4h")
    s.add_argument("--from", dest="base")
    s.add_argument("--setup", help="docker, or a local setup script")
    s = sub.add_parser("push")
    s.add_argument("task")
    s.add_argument("local", nargs="?", default=".")
    s.add_argument("remote", nargs="?")
    s.add_argument("--allow", action="append", default=[])
    s = sub.add_parser("put")
    s.add_argument("task")
    s.add_argument("local")
    s.add_argument("remote")
    s.add_argument("--allow", action="append", default=[])
    s = sub.add_parser("get")
    s.add_argument("task")
    s.add_argument("remote")
    s.add_argument("--hidden", action="store_true", help="also accept files and folders whose names start with a dot (never .git)")
    s.add_argument("--merge", action="store_true", help="merge into an existing folder and replace same-named files")
    s.add_argument("local")
    s = sub.add_parser("exec")
    s.add_argument("task")
    s.add_argument("--detach", metavar="JOB")
    s.add_argument("--cwd")
    s = sub.add_parser("wait")
    s.add_argument("task")
    s.add_argument("job")
    s.add_argument("--timeout")
    s = sub.add_parser("logs")
    s.add_argument("task")
    s.add_argument("job")
    s.add_argument("-n", type=int, default=40)
    s.add_argument("-f", "--follow", action="store_true")
    sub.add_parser("ls")
    s = sub.add_parser("rm")
    s.add_argument("tasks", nargs="+")
    s.add_argument("--forget", action="store_true", help="drop local key, state and watchdog without asking Hetzner")
    s = sub.add_parser("clean")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--mine", action="store_true")
    g.add_argument("--owner")
    g.add_argument("--all", action="store_true")
    sub.add_parser("sweep", help="one cleanup run as the launchd job does it")
    s = sub.add_parser("sweeper")
    s.add_argument("action", choices=["install", "uninstall", "status"])
    s = sub.add_parser("base")
    s.add_argument("action", choices=["create", "ls", "rm"])
    s.add_argument("base", nargs="?")
    s.add_argument("--setup", default="docker")
    s.add_argument("--type", default="cx23")
    s.add_argument("--location")
    argv = sys.argv[1:]
    command = []
    if argv[:1] == ["exec"]:  # everything after the first -- is the command, untouched by option parsing
        if "--" not in argv:
            die("exec: put the command after --, for example: offload exec <task> -- 'make -j16'")
        command, argv = argv[argv.index("--") + 1:], argv[:argv.index("--")]
    a = p.parse_args(argv)
    a.command = command
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    refresh_bin()
    if a.cmd in ("sweep", "sweeper"):  # sweep loads the token itself and logs a missing one
        return {"sweep": cmd_sweep, "sweeper": cmd_sweeper}[a.cmd](a)
    token = resolve_token()
    if not token:
        die(f"no Hetzner Cloud token: set ${TOKEN_VAR} (or name another variable in OFFLOAD_TOKEN_VAR), list a file that "
            f"defines it in OFFLOAD_SECRET_FILES, or create an hcloud context (`hcloud context create <name>`). Nothing done.")
    use_token(token)  # for hcloud and the watchdog: environment only, never a command line
    {"types": cmd_types, "create": cmd_create, "push": cmd_push, "put": cmd_put, "get": cmd_get, "exec": cmd_exec, "wait": cmd_wait,
     "logs": cmd_logs, "ls": cmd_ls, "rm": cmd_rm, "clean": cmd_clean, "base": cmd_base}[a.cmd](a)


if __name__ == "__main__":
    main()
