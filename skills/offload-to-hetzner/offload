# Secret scan. Names of variables that hold credentials; PAT only as a whole part, else PATH would match.
SECRET_NAME_RE = re.compile(r"(TOKEN|SECRET|PASS|KEY|PSK|CREDENTIAL|(?:^|_)PAT(?:_|$))", re.I)
# Values that are no secret even under such a name: bare origins, paths on this Mac, numbers, booleans.
# Deliberately narrow: base64 secrets can start with a slash.
HARMLESS_RE = re.compile(r"^(https?://[A-Za-z0-9.-]+(:\d+)?/?|(~|/(Users|opt|usr|private|tmp|var|etc|Applications|Library|System|bin|sbin))(/\S*)?"
                         r"|\d+|true|false)$", re.I)
TOKEN_RE = re.compile(
    rb"(?P<private_key>-----BEGIN [A-Z ]*PRIVATE KEY-----)|(?P<aws_key>\bAKIA[0-9A-Z]{16}\b)"
    rb"|(?P<github_token>\bgh[pousr]_[A-Za-z0-9]{36,}|\bgithub_pat_[A-Za-z0-9_]{40,})|(?P<gitlab_token>\bglpat-[A-Za-z0-9_-]{20,})"
    rb"|(?P<slack_token>\bxox[abposr]-[0-9]{6,}-[A-Za-z0-9-]{10,})"
    rb"|(?P<api_key>(?<![A-Za-z0-9_-])sk-(?:ant-|proj-)?(?=[A-Za-z0-9_-]*[0-9])(?=[A-Za-z0-9_-]*[A-Z])[A-Za-z0-9_-]{32,})"
    rb"|(?P<stripe_live_key>\b(?:sk|rk)_live_[A-Za-z0-9]{20,})|(?P<google_api_key>\bAIza[0-9A-Za-z_-]{35})")
SECRET_FILE_RE = re.compile(
    r"(^|/)(\.env(\.(?!(example|sample|template|dist)$)[^/]+)?|[^/]*\.(pem|key|p12|pfx|jks|keystore|kdbx|tfstate)"
    r"|id_(rsa|dsa|ecdsa|ed25519)|\.netrc|\.pgpass|credentials(\.json)?|service[-_]account[^/]*\.json)$", re.I)
DATA_FILE_RE = re.compile(r"\.(sql|sql\.gz|dump|sqlite3?|db|bak)$", re.I)
SHELL_EXPANSION_RE = re.compile(r"[A-Za-z0-9_{(@*#?$!\-]")


def die(msg, code=1):
    print(f"offload: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


def say(msg):
    print(msg, flush=True)


def warn(msg):
    print(f"offload: {msg}", file=sys.stderr, flush=True)


def lock(task, shared=False):
    """Per-task lock for all agents on this Mac. create, rm, clean and base take it alone (exclusive) while they change
    a task; push, put, get, exec, wait and logs share it while they work, so rm and clean skip a task in use instead of
    deleting its server mid-transfer. Returns the open lock file (keep a reference) or None when it is taken."""
    f = open(STATE / f".{task}.lock", "a")
    try:
        fcntl.flock(f, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        return f
    except BlockingIOError:
        f.close()
        return None


def lock_or_die(task):
    return lock(task) or die(f"another offload command is working on {task} right now (a push, get, exec, wait or logs "
                             f"counts too); try again when it is done")


def use(task):
    """For the work commands: the task's server, and a shared lock held until the command ends."""
    global HELD
    HELD = lock(task, shared=True) or die(f"{task} is being created or removed right now; try again when that is done")
    return need(task)


