def hcloud(*args, check=True):
    try:
        r = subprocess.run(["hcloud", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=HCLOUD_TIMEOUT)
    except subprocess.TimeoutExpired:
        r = subprocess.CompletedProcess(["hcloud", *args], 124, "", f"no answer from the Hetzner API within {HCLOUD_TIMEOUT} s")
    except FileNotFoundError:
        die("hcloud not found; install it first (brew install hcloud)")
    if check and r.returncode:
        die(f"hcloud {' '.join(args[:2])}: {r.stderr.strip()[:400]}")
    return r


def hjson(*args):
    return json.loads(hcloud(*args, "-o", "json").stdout or "null")


